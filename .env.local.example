# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA suba o .env.local para o GitHub nem o compartilhe em texto puro.

# Supabase — encontre em: painel do projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://ucksyspdwbwqsyhafrxo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — encontre em: Painel do desenvolvedor > Suas integrações > [sua aplicação] > Credenciais
# Comece com as credenciais de TESTE; troque para produção só quando validar o fluxo inteiro.
MERCADOPAGO_ACCESS_TOKEN=
# "Chave secreta" configurada na aba Webhooks da sua aplicação no Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site depois de publicado (sem barra no final)
# Em desenvolvimento local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
